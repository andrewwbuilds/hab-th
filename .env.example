# Supabase (local: values printed by `npx supabase start`; cloud: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-up form accepts this code to create an organizer account
ORGANIZER_INVITE_CODE=encore-crew

# Used by scripts/seed.ts for demo accounts
SEED_PASSWORD=encore-demo-2026

# "1" shows one-click demo sign-in buttons that use SEED_PASSWORD (fine for the demo deployment)
DEMO_LOGIN=1

# Roadie assistant. Leave every line empty and the assistant answers from the form definition alone.
# Groq key (https://console.groq.com); picked first when set
GROQ_API_KEY=
# OpenRouter key (https://openrouter.ai/keys); used when there is no Groq key
OPENROUTER_API_KEY=
# groq | openrouter | offline; overrides the key-based choice
AI_PROVIDER=
# model id sent to the chosen provider; defaults to openai/gpt-oss-120b on Groq, google/gemma-4-31b-it:free on OpenRouter
AI_MODEL=

# Selfie guides are redrawn in the Encore style through OpenRouter's Images API (Groq has no image output and
# OpenRouter has no free image model; the default costs about 4 cents a portrait). Needs OPENROUTER_API_KEY;
# without it the picker keeps the pixel look. AI_PROVIDER=offline turns portraits off too.
# defaults to google/gemini-3.1-flash-lite-image with google/gemini-2.5-flash-image as the fallback
AI_IMAGE_MODEL=
